{
    "name": "koh/sylius-indexnow",
    "description": "IndexNow for Sylius: announces changed, launched and removed products and taxons per channel host. Derived per-host keys, production only, a retrying queue.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "indexnow",
        "seo",
        "bing",
        "ecommerce"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source",
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/sylius-indexnow/-/issues",
        "source": "https://github.com/ole-hartwig/sylius-indexnow"
    },
    "require": {
        "php": "^8.5.11",
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/migrations": "^3.9.8",
        "doctrine/orm": "^2.18 || ^3.0",
        "doctrine/persistence": "^3.3 || ^4.0",
        "guzzlehttp/psr7": "^2.13.1",
        "koh/indexnow": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "sylius/sylius": "^2.2.9 || ^2.3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-client-contracts": "^3.7.3",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/lock": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.6",
        "phpstan/phpstan": "^2.2.16",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Koh\\IndexNow\\Sylius\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\IndexNow\\Sylius\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/flex": false,
            "symfony/runtime": false,
            "infection/extension-installer": true
        }
    }
}
